{
	"name": "homepage",
	"version": "1.0.0",
	"description": "A personal homepage",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/flaycock/homepage.git"
	},
	"scripts": {
		"build": "node esbuild.config.js",
		"start": "node esbuild.config.js --serve",
		"lint": "biome lint",
		"lint:fix": "biome lint --write",
		"test": "jest",
		"test:coverage": "jest --coverage",
		"prepare": "husky"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.6",
		"@testing-library/jest-dom": "7.0.0",
		"@testing-library/react": "16.3.2",
		"@types/jest": "30.0.0",
		"@types/node": "26.1.0",
		"@types/react": "19.2.0",
		"@types/react-dom": "19.2.0",
		"esbuild": "0.28.1",
		"husky": "9.1.7",
		"jest": "30.4.2",
		"jest-environment-jsdom": "30.4.1",
		"ts-jest": "29.4.12",
		"ts-node": "10.9.2",
		"typescript": "6.0.3"
	},
	"dependencies": {
		"@chakra-ui/react": "3.36.1",
		"next-themes": "0.4.6",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"react-icons": "5.7.0",
		"styled-components": "6.4.4"
	},
  "packageManager": "pnpm@10.6.0",
  "engines": {
    "node": "24.15.0",
    "pnpm": "10.6.0"
  },
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild"
		],
		"ignoredBuiltDependencies": [
			"unrs-resolver"
		]
	}
}
